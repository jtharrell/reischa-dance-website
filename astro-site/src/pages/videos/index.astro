---
import BaseLayout from '../../layouts/BaseLayout.astro';
import VideoEmbed from '../../components/VideoEmbed.astro';
import SplitBioLayout from '../../components/SplitBioLayout.astro';
import videosHero from '../../assets/hero/videos.jpg';

const videos = [
	{ videoId: 'wXhiKzhi8Oc', title: 'Zeina', caption: 'Dancing a benefit at That\'s Cool Speakeasy.' },
	{ videoId: '-Qeidiv9lbs', title: 'Tamra Henna', caption: 'Art Benefit at Daisy Dukes, November 2013.' },
	{ videoId: 'OOoIjIKBjbM', title: 'Nebtiti Menin el Hekia', caption: 'Dancing at Euro Grill on New Years Eve.' },
	{ videoId: 'DmwqNpDK-Fs', title: 'Improvising', caption: 'Reischa dancing at an Egyptian Baby Shower.' },
];
---

<BaseLayout title="Videos" description="Solo bellydance performance videos by Reischa.">
	<SplitBioLayout
		image={videosHero}
		imageAlt="Reischa in a teal beaded costume"
		title="Videos — Solo Dances"
	>
		<div class="video-grid">
			{videos.map((video) => <VideoEmbed {...video} />)}
		</div>
		<a class="back-link" href="/videos/group-choreography/">Group Choreography &rarr;</a>
	</SplitBioLayout>
</BaseLayout>

<style>
	.video-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 2rem;
	}

	@media (min-width: 40rem) {
		.video-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}
</style>
