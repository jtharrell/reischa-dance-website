---

<BaseLayout title="Resume" description="Reischa Feuerbacher's professional performance, teaching, and choreography resume.">
	<div class="resume-page">
	<div class="resume-header">
		<h1>Reischa's Resume</h1>
		<p class="lede">Professional Oriental Dancer &amp; Instructor</p>
	</div>

	<section class="resume-section performance-section">
		<h2>Performance Experience &mdash; Restaurant &amp; Club</h2>
		<ul class="credit-list">
			{restaurantClub.map(([venue, role]) => (
				<li><span class="credit-title">{venue}</span><span class="credit-role">{role}</span><span class="credit-venue"></span></li>
			))}
		</ul>
		<Image class="performance-photo" src={performancePhoto} alt="Reischa performing in a red dance costume" width={400} format="webp" />
	</section>

	<section class="resume-section">
		<h2>Theatre / Concert</h2>
		<ul class="credit-list">
			{theatreConcert.map(([title, role, venue]) => (
				<li><span class="credit-title">{title}</span><span class="credit-role">{role}</span><span class="credit-venue">{venue}</span></li>
			))}
		</ul>
	</section>

	<section class="resume-section">
		<h2>Film / Video</h2>
		<ul class="credit-list">
			{filmVideo.map(([title, role, venue]) => (
				<li><span class="credit-title">{title}</span><span class="credit-role">{role}</span><span class="credit-venue">{venue}</span></li>
			))}
		</ul>
	</section>

	<section class="resume-section">
		<h2>Festivals &amp; Special Events</h2>
		<ul class="credit-list">
			{festivals.map(([title, role, venue]) => (
				<li><span class="credit-title">{title}</span><span class="credit-role">{role}</span><span class="credit-venue">{venue}</span></li>
			))}
		</ul>
	</section>

	<section class="resume-section">
		<h2>Choreography Work</h2>
		<ul class="credit-list">
			{choreography.map(([venue, project]) => (
				<li><span class="credit-title">{venue}</span><span class="credit-role">{project}<br />(Choreographer)</span><span class="credit-venue"></span></li>
			))}
		</ul>
	</section>

	<section class="resume-section">
		<h2>Stylization &amp; Specialties</h2>
		<p>
			Egyptian &amp; Lebanese Cabaret, American Cabaret, Egyptian
			Folkloric, Turkish Folkloric, Debke, Cane, Zills, Sword, Veil,
			Floor work, Choreography, Acting for Dancers.
		</p>
	</section>

	<section class="resume-section">
		<h2>Education</h2>
		<ul class="credit-list">
			{education.map(([type, instructor, format]) => (
				<li><span class="credit-title">{type}</span><span class="credit-role">{instructor}</span><span class="credit-venue">{format}</span></li>
			))}
		</ul>
	</section>

	<section class="resume-section">
		<h2>Bachelor of Art</h2>
		<ul class="credit-list">
			<li><span class="credit-title">Major: Theater Performance</span><span class="credit-role">Minor: Voice</span><span class="credit-venue">Middle Tennessee State University</span></li>
		</ul>
	</section>

	<section class="resume-section">
		<h2>Teaching</h2>
		<ul class="credit-list">
			{teaching.map(([type, venue, format]) => (
				<li><span class="credit-title">{type}</span><span class="credit-role">{venue}</span><span class="credit-venue">{format}</span></li>
			))}
		</ul>
	</section>

	<section class="resume-section">
		<h2>Miscellaneous</h2>
		<p>
			Guest Performer: Workshops &amp; Events in Lexington, Ohio,
			Florida, Alabama, etc.<br />
			Spanish Dance Society: Testing up to Level 3, Extensive Theater
			Training &amp; Performance.<br />
			Additional Dance Training / Practice with Arabic Musicians.
		</p>
		<p>
			<strong>Presentations</strong><br />
			Roots, Rhythm &amp; Religion: World Music &amp; Dance at
			Vanderbilt &mdash; presented on behalf of the Vanderbilt
			University Dance Program.<br />
			History &amp; Health Benefits of Bellydance &mdash; TN State
			Parks Recreation Conference (Metro Parks).<br />
			Celebrating a Multi-Cultural Christmas &mdash; Nashville Public
			Library.<br />
			History &amp; Health Benefits of Bellydance &mdash;
			International Week at MTSU.
		</p>
	</section>

	<a class="back-link" href="/about/">&larr; Back to About</a>
	</div>
</BaseLayout>

<style>
	:global(main:has(.resume-page)) {
		background: var(--color-surface);
		color: var(--color-ink);
	}

	:global(main:has(.resume-page) h1),
	:global(main:has(.resume-page) h2) {
		color: var(--color-maroon);
	}

	:global(main:has(.resume-page) h1) {
		font-family: var(--font-script);
		font-size: clamp(2.5rem, 8vw, 3.5rem);
		line-height: 1;
		margin: 0 0 0.5rem;
	}

	:global(main:has(.resume-page) a) {
		color: var(--color-maroon);
	}

	:global(main:has(.resume-page) a:hover) {
		color: var(--color-mauve);
	}

	:global(main:has(.resume-page) .lede) {
		color: var(--color-ink-soft);
	}

	:global(main:has(.resume-page) .resume-header) {
		border-bottom-color: var(--color-mauve-light);
	}

	:global(main:has(.resume-page) .resume-section h2) {
		border-bottom-color: rgb(58 36 48 / 15%);
	}

	:global(main:has(.resume-page) .credit-list li) {
		border-bottom-color: rgb(58 36 48 / 15%);
	}

	:global(main:has(.resume-page) .credit-role) {
		color: var(--color-ink-soft);
	}

	:global(main:has(.resume-page) .credit-venue) {
		color: var(--color-mauve);
	}

	.performance-section {
		position: relative;
	}

	.performance-photo {
		display: block;
		width: 100%;
		height: auto;
		margin-top: 1.5rem;
		border-radius: 0.5rem;
	}

	@media (min-width: 48rem) {
		.performance-photo {
			position: absolute;
			top: 2.75rem;
			right: 0;
			bottom: 0;
			width: 14rem;
			height: auto;
			margin-top: 0;
			object-fit: cover;
			object-position: center;
		}
	}
</style>
