---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import recentCover from '../../../assets/gallery/live/recent/recent3.jpg';
import pastCover from '../../../assets/gallery/live/past/Live001.jpg';
---

<BaseLayout title="Live Photos" description="Live performance photos of Reischa bellydancing.">
	<div class="plain-page">
		<h1>Live Photos</h1>
		<div class="gallery-tiles">
			<a class="gallery-tile" href="/gallery/live/recent/">
				<Image src={recentCover} alt="Recent live performance photos" width={480} format="webp" />
				<span>Recent</span>
			</a>
			<a class="gallery-tile" href="/gallery/live/past/">
				<Image src={pastCover} alt="Past live performance photos" width={480} format="webp" />
				<span>Past</span>
			</a>
		</div>
		<a class="back-link" href="/gallery/">&larr; Back to Galleries</a>
	</div>
</BaseLayout>

<style>
	.gallery-tiles {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1.5rem;
		margin-bottom: 1.5rem;
	}

	.gallery-tile {
		position: relative;
		display: block;
		border-radius: 10px;
		overflow: hidden;
		text-decoration: none;
	}

	.gallery-tile :global(img) {
		width: 100%;
		height: 100%;
		aspect-ratio: 4 / 3;
		object-fit: cover;
		display: block;
		transition: transform 0.25s ease;
	}

	.gallery-tile:hover :global(img),
	.gallery-tile:focus-visible :global(img) {
		transform: scale(1.04);
	}

	.gallery-tile span {
		position: absolute;
		inset: auto 0 0 0;
		padding: 1rem;
		background: linear-gradient(to top, rgb(58 36 48 / 75%), transparent);
		color: #fff;
		font-family: var(--font-heading);
		font-size: 1.5rem;
	}

	@media (min-width: 40rem) {
		.gallery-tiles {
			grid-template-columns: repeat(2, 1fr);
		}
	}
</style>
