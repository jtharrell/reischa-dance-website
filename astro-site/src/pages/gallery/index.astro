---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import liveCover from '../../assets/gallery/live/Live001.jpg';
import studioCover from '../../assets/gallery/studio/Studio001.jpg';
---

<BaseLayout title="Gallery" description="Photos of Reischa bellydancing live at performances and in the studio.">
	<h1>Gallery</h1>
	<div class="gallery-tiles">
		<a class="gallery-tile" href="/gallery/live/">
			<Image src={liveCover} alt="Live performance photos" width={480} format="webp" />
			<span>Live</span>
		</a>
		<a class="gallery-tile" href="/gallery/studio/">
			<Image src={studioCover} alt="Studio photos" width={480} format="webp" />
			<span>Studio</span>
		</a>
	</div>
</BaseLayout>

<style>
	.gallery-tiles {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1.5rem;
	}

	.gallery-tile {
		position: relative;
		display: block;
		border-radius: 10px;
		overflow: hidden;
		text-decoration: none;
	}

	.gallery-tile :global(img) {
		width: 100%;
		height: 100%;
		aspect-ratio: 4 / 3;
		object-fit: cover;
		display: block;
		transition: transform 0.25s ease;
	}

	.gallery-tile:hover :global(img),
	.gallery-tile:focus-visible :global(img) {
		transform: scale(1.04);
	}

	.gallery-tile span {
		position: absolute;
		inset: auto 0 0 0;
		padding: 1rem;
		background: linear-gradient(to top, rgb(58 36 48 / 75%), transparent);
		color: #fff;
		font-family: var(--font-heading);
		font-size: 1.5rem;
	}

	@media (min-width: 40rem) {
		.gallery-tiles {
			grid-template-columns: repeat(2, 1fr);
		}
	}
</style>
