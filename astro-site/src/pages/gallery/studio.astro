---
import BaseLayout from '../../layouts/BaseLayout.astro';
import GalleryGrid from '../../components/GalleryGrid.astro';
import HomeHero from '../../components/HomeHero.astro';
import studioHero from '../../assets/hero/belly-dance.jpg';

const imageModules = import.meta.glob<{ default: ImageMetadata }>('/src/assets/gallery/studio/*.jpg', { eager: true });
const images = Object.keys(imageModules)
	.sort()
	.map((path) => imageModules[path].default);
---

<BaseLayout title="Studio Photos" description="Studio photos of Reischa bellydancing.">
	<HomeHero
		slot="hero"
		image={studioHero}
		imageAlt="Reischa in a purple beaded costume, sweeping a purple veil"
		panelMaxWidth="60rem"
		panelAlign="center"
	>
		<h1>Studio Photos</h1>
		<GalleryGrid images={images} altPrefix="Reischa studio photo" />
		<a class="back-link" href="/gallery/">&larr; Back to Gallery</a>
	</HomeHero>
</BaseLayout>
