---
import BaseLayout from '../../layouts/BaseLayout.astro';
import GalleryGrid from '../../components/GalleryGrid.astro';

const imageModules = import.meta.glob<{ default: ImageMetadata }>('/src/assets/gallery/studio/*.jpg', { eager: true });
const images = Object.keys(imageModules)
	.sort()
	.map((path) => imageModules[path].default);
---

<BaseLayout title="Studio Photos" description="Studio photos of Reischa bellydancing.">
	<div class="plain-page">
		<h1>Studio Photos</h1>
		<p class="credits">Credits: Michael Gomez, Nikki McFadden, John Gentry</p>
		<GalleryGrid images={images} altPrefix="Reischa studio photo" />
		<a class="back-link" href="/gallery/">&larr; Back to Galleries</a>
	</div>
</BaseLayout>

<style>
	.credits {
		margin-top: -0.5rem;
		margin-bottom: 1.5rem;
		font-size: 0.9rem;
		color: var(--color-ink-soft);
		text-align: center;
	}
</style>
