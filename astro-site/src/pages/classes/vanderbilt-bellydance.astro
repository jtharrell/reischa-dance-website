---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SplitBioLayout from '../../components/SplitBioLayout.astro';
import vandyHero from '../../assets/hero/attire.png';
import vandyClassPic from '../../assets/hero/vandy-class-pic.jpg';
---

<BaseLayout title="Vanderbilt Bellydance (Archived)" description="Archived Vanderbilt Dance Program bellydance class listing.">
	<SplitBioLayout
		image={vandyHero}
		imageAlt="Reischa in a teal beaded costume, posing in front of a brick and window backdrop"
		title="Vanderbilt Belly Dance"
		mediaFraction={0.3}
		mediaWidth="27rem"
		mediaHeight="48rem"
	>
		<section class="section">
			<h2>Beginner / Intermediate Bellydance (Past)</h2>
			<p>Class started August 25th, 2014. Mondays, 6:00 &ndash; 7:00 PM.</p>
			<p>Class meeting location: Memorial Gym, 2201 West End, Nashville, TN 37240</p>
			<p>
				Beginner / Intermediate Level, Studio A. This is an
				introduction to the fundamentals of belly dance used in all
				styles. Fundamentals will be covered through a series of
				basic technique exercises, combinations, and choreography.
				This is a beginner level class, but it is also a wonderful
				refresher course. This class will include Intermediate level
				information.
			</p>
		</section>

		<Image class="class-pic" src={vandyClassPic} alt="Reischa's Vanderbilt bellydance class" width={640} format="webp" />

		<a class="back-link" href="/classes/">&larr; Back to Classes</a>
	</SplitBioLayout>
</BaseLayout>

<style>
	.class-pic {
		width: 24rem;
		height: auto;
		border-radius: 0.5rem;
		display: block;
		margin: 0 0 2rem;
	}
</style>
