---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SplitBioLayout from '../../components/SplitBioLayout.astro';
import millenniumHero from '../../assets/hero/attire.png';
---

<BaseLayout title="Class Information" description="Bellydance class details at Millennium Dance Complex in Nashville, TN.">
	<SplitBioLayout
		image={millenniumHero}
		imageAlt="Reischa in a teal beaded costume, posing in front of a brick and window backdrop"
		title="Class Information"
		mediaFraction={0.3}
		mediaWidth="27rem"
		mediaHeight="48rem"
	>
		<section class="section">
			<h2>Beginner / Intermediate Bellydance</h2>
			<p><strong>See below for class offerings. Contact Reischa for private sessions.</strong></p>
			<p>
				Beginner / Intermediate Level, Studio Y. This is an
				introduction to the fundamentals of belly dance used in all
				styles. Fundamentals will be covered through a series of
				basic technique exercises, combinations, and choreography.
				This is a beginner level class, but it is also a wonderful
				refresher course. <strong>This class will include some
				Intermediate level information.</strong>
			</p>
		</section>

		<section class="section">
			<h2>Intermediate / Advanced Bellydance</h2>
			<p>
				This class is not meeting until further notice. For the time
				being, the Intermediate Class is being integrated into the
				Beginner Class listed above.
			</p>
			<p>
				This is a continuation of belly dance fundamentals.
				Challenging exercises, combinations, choreography, and even
				improvisation will be studied.
				<strong>This is an intermediate level class recommended to students with prior study.</strong>
			</p>

			<p>
				Feel free to email / call Reischa with questions regarding
				these classes.<br />
				<a href="mailto:luri7@yahoo.com">luri7@yahoo.com</a><br />
				615-593-7119
			</p>
		</section>

		<section class="section">
			<h2>Class Details</h2>
			<dl class="class-meta">
				<dt>Class Meeting Times</dt>
				<dd>Additional classes coming in the future. This is a busy performance season.</dd>

				<dt>Class Meeting Location</dt>
				<dd>Millennium Dance Complex<br />2844 Logan St<br />Nashville, TN 37211</dd>

				<dt>Registration</dt>
				<dd>Email Reischa at <a href="mailto:luri7@yahoo.com">luri7@yahoo.com</a>. Early registration is encouraged.</dd>

				<dt>Pricing</dt>
				<dd>$15 per class</dd>

				<dt>Payment</dt>
				<dd>Cash or check can be received on the first day of class. Other payment options can be sent via email.</dd>
			</dl>
		</section>

		<a class="back-link" href="/classes/">&larr; Back to Classes</a>
	</SplitBioLayout>
</BaseLayout>
