---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import vandyHero from '../../assets/hero/classes-generic.jpg';
---

<BaseLayout title="Vanderbilt Flamenco (Archived)" description="Archived Vanderbilt Dance Program flamenco class listing.">
	<PageHero slot="hero" image={vandyHero} title="Vanderbilt Dance Program — Flamenco Class" showTitle />

	<p class="lede">Flamenco Class</p>
	<p><em>Archived listing from Reischa's time as a Vanderbilt Dance Program instructor.</em></p>

	<div class="class-info-grid">
		<div>
			<h2>Flamenco &mdash; Ingreso &amp; Year 1</h2>
			<p>Class started August 25th, 2014. Mondays, 5:00 &ndash; 6:00 PM.</p>
			<p>
				Beginner / Intermediate Level. This is an introduction to the
				fundamentals of classical Spanish dance, flamenco, &amp;
				escuela bolera. Class material will include beginner level
				exercises &amp; flamenco choreographies. This is a beginner to
				intermediate level class. Beginners may start at any time.
			</p>
			<p>
				Please look over the Class <a href="/classes/attire/">Attire Page</a> for information on shoes and clothing.
			</p>
			<p>
				Feel free to email / call Reischa with questions regarding
				these classes.<br />
				<a href="mailto:luri7@yahoo.com">luri7@yahoo.com</a><br />
				615-593-7119
			</p>
		</div>

		<dl class="class-meta">
			<dt>Class Meeting Location</dt>
			<dd>Memorial Gym<br />2201 West End<br />Nashville, TN 37240</dd>

			<dt>Registration Dates</dt>
			<dd>
				Aug 19th &ndash; 23rd at Sarratt Center Lobby.
				(<a href="http://www.vanderbilt.edu/dance/about-the-program/directions/" target="_blank" rel="noopener noreferrer">Directions</a>)<br />
				12&ndash;6 PM Tuesday&ndash;Friday / 11am&ndash;4pm Saturday, <strong>OR</strong> late registration at the Memorial Gym Dance Studios (cash or check only).
			</dd>

			<dt>Pricing</dt>
			<dd>
				14-week session.<br />
				Community Members / Non-students: $136<br />
				VU Faculty / Staff: $124<br />
				VU Students: $112<br />
				Single Classes: $12.00 each
			</dd>

			<dt>Contact Information</dt>
			<dd>
				Please contact Kelvin Amburgy at the Vanderbilt Dance Program
				for more registration information.<br />
				Sarratt Center: 322-2471 / 322-6400<br />
				<a href="http://www.vanderbilt.edu/dance" target="_blank" rel="noopener noreferrer">Website</a>
			</dd>
		</dl>
	</div>

	<a class="back-link" href="/classes/">&larr; Back to Classes</a>
</BaseLayout>
