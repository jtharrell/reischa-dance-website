---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HomeHero from '../../components/HomeHero.astro';
import classesHero from '../../assets/hero/classes.jpg';
---

<BaseLayout title="Classes" description="Bellydance classes taught by Reischa in Nashville, TN, plus private lessons and special events.">
	<HomeHero
		slot="hero"
		image={classesHero}
		imageAlt="Reischa in a purple beaded costume, arching backward mid-pose"
		imageWidth="44rem"
	>
		<h1>Classes</h1>
		<p>
			Reischa teaches bellydance in Nashville, TN, offering group classes,
			private lessons, and instruction for special events.
		</p>

		<h2>Nashville Bellydance Class</h2>
		<p>
			<a href="/classes/millennium/">@ Millennium Dance Complex</a>
		</p>
		<p>
			<a href="/classes/millennium/">Upcoming Group Class</a><br />
			May 24 (4:00 PM &ndash; 5:00 PM)
		</p>
		<p>
			Some class updates can be found on <a href="https://www.facebook.com/profile.php?id=61579200180746" target="_blank" rel="noopener noreferrer">this Facebook page</a>.
		</p>

		<h2>Private Classes &amp; Special Events</h2>
		<p>
			Planning an event? Reischa is available to teach at parties and
			private classes.
		</p>

		<h2>Past Vanderbilt Dance Program Classes</h2>
		<p>
			Reischa taught bellydance and flamenco at Vanderbilt University for
			12 years. Those class listings are kept below for reference.
		</p>
		<ul>
			<li><a href="/classes/vanderbilt-bellydance/">Vanderbilt Bellydance (archived)</a></li>
			<li><a href="/classes/vanderbilt-flamenco/">Vanderbilt Flamenco (archived)</a></li>
		</ul>

		<a class="back-link" href="/classes/attire/">Recommended Attire &rarr;</a>
	</HomeHero>
</BaseLayout>
