---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SplitBioLayout from '../../components/SplitBioLayout.astro';
import eventsHero from '../../assets/hero/reischa-in-red.jpg';
---

<BaseLayout title="Events" description="Upcoming and recent bellydance performances by Reischa in the Nashville area and beyond.">
	<SplitBioLayout
		image={eventsHero}
		imageAlt="Reischa dancing at a live performance venue"
		title="Events"
		mediaFraction={0.3}
	>
		<section class="section">
			<h2>Upcoming Performances</h2>
			<ul>
				<li><strong>Sufi's Mediterranean</strong>, Germantown, TN on Aug 29th + various dates</li>
				<li><strong>Workshop Show</strong>, Classes w/ Angel, Aug 15th</li>
				<li><strong>A Night at the Cabaret</strong>, Samira Workshop at Ritz Midtown in Paducah, KY on September 12th @ 7pm</li>
			</ul>
		</section>

		<section class="section">
			<h2>Recent Performances</h2>
			<ul>
				<li>Special party</li>
				<li>Private wedding event (AL)</li>
				<li>Bosnian events (Bowling Green, KY), 2025 + 2026</li>
				<li>Taverna on the Green (Cookeville, TN)</li>
				<li>Saddle Farms Event Center, Engagement party</li>
			</ul>
		</section>

		<section class="section">
			<h2>Past Performances</h2>
			<ul>
				<li>Aladdin's, Parisa's Restaurant, Shuddh Des Radio</li>
			</ul>
		</section>

		<a class="back-link" href="/events/past/">Notable Past Performances &rarr;</a>
	</SplitBioLayout>
</BaseLayout>
