---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import GalleryGrid from '../../../components/GalleryGrid.astro';

const imageModules = import.meta.glob<{ default: ImageMetadata }>('/src/assets/acting/gallery/live/*.{jpg,JPG}', { eager: true });
// Natural sort by filename so Live2 comes before Live10.
const fileName = (path: string) => path.slice(path.lastIndexOf('/') + 1).replace(/\.[^.]+$/, '');
const paths = Object.keys(imageModules)
	.sort((a, b) => fileName(a).localeCompare(fileName(b), undefined, { numeric: true, sensitivity: 'base' }));
const images = paths.map((path) => imageModules[path].default);
// Too soft when enlarged to fill the lightbox, so these stay at their own size.
const lowRes = ['live26', 'live32'];
const noEnlarge = paths.filter((path) => lowRes.includes(fileName(path))).map((path) => imageModules[path].default);
---

<BaseLayout title="Live Photos" description="Live photos of Reischa acting.">
	<div class="plain-page">
		<h1>Live Photos</h1>
		{images.length > 0
			? <GalleryGrid images={images} altPrefix="Reischa acting live" noEnlarge={noEnlarge} />
			: <p class="empty">Photos coming soon.</p>}
		<a class="back-link" href="/acting/galleries/">&larr; Back to Galleries</a>
	</div>
</BaseLayout>

<style>
	.empty {
		text-align: center;
		color: var(--color-ink-soft);
	}
</style>
