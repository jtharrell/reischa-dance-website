---
import '@fontsource/alex-brush';
import '@fontsource/playfair-display/400.css';
import '@fontsource/playfair-display/700.css';
import '@fontsource/mulish/400.css';
import '@fontsource/mulish/600.css';
import '../styles/global.css';

export interface Props {
	title: string;
	description?: string;
}

const { title, description = 'Reischa is a professional belly dance artist, performer, and instructor based in Nashville, TN.' } = Astro.props;

const navLinks = [
	{ href: '/', label: 'Home' },
	{ href: '/about/', label: 'About' },
	{ href: '/classes/', label: 'Classes' },
	{ href: '/events/', label: 'Events' },
	{ href: '/gallery/', label: 'Gallery' },
	{ href: '/videos/', label: 'Videos' },
	{ href: '/acting/', label: 'Acting' },
	{ href: '/links/', label: 'Links' },
	{ href: '/contact/', label: 'Contact' },
];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<title>{title} | Reischa Dance</title>
	</head>
	<body>
		<header class="site-header">
			<div class="site-header__bar">
				<a class="site-header__brand" href="/">
					Reischa
					<span class="site-header__tagline">Belly Dancer &middot; Actress</span>
				</a>
				<button
					class="nav-toggle"
					id="nav-toggle"
					aria-expanded="false"
					aria-controls="primary-nav"
				>
					<span class="sr-only">Menu</span>
					<span class="nav-toggle__bars" aria-hidden="true"></span>
				</button>
				<nav class="primary-nav" id="primary-nav">
					<ul>
						{navLinks.map((link) => (
							<li><a href={link.href}>{link.label}</a></li>
						))}
					</ul>
				</nav>
			</div>
		</header>

		<main>
			<slot name="hero" />
			<div class="content-wrapper">
				<slot />
			</div>
		</main>

		<footer class="site-footer">
			<p>&copy; {new Date().getFullYear()} Reischa Bellydance.</p>
		</footer>

		<script>
			const toggle = document.getElementById('nav-toggle');
			const nav = document.getElementById('primary-nav');
			toggle?.addEventListener('click', () => {
				const isOpen = nav?.classList.toggle('is-open');
				toggle.setAttribute('aria-expanded', String(Boolean(isOpen)));
			});
		</script>
	</body>
</html>
