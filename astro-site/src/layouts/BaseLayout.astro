---
import '@fontsource/alex-brush';
import '@fontsource/playfair-display/400.css';
import '@fontsource/playfair-display/700.css';
import '@fontsource/mulish/400.css';
import '@fontsource/mulish/600.css';
import '@fontsource/mulish/700.css';
import '../styles/global.css';

export interface Props {
	title: string;
	description?: string;
}

const { title, description = 'Reischa is a professional belly dance artist, performer, and instructor based in Nashville, TN.' } = Astro.props;

// The site is two sites under one roof: dance at the root, acting under /acting.
const isActing = Astro.url.pathname === '/acting' || Astro.url.pathname.startsWith('/acting/');

const danceNavLinks = [
	{ href: '/', label: 'Home' },
	{ href: '/about/', label: 'About' },
	{ href: '/classes/', label: 'Classes' },
	{ href: '/events/', label: 'Events' },
	{ href: '/gallery/', label: 'Gallery' },
	{ href: '/videos/', label: 'Videos' },
	{ href: '/links/', label: 'Links' },
	{ href: '/contact/', label: 'Contact' },
];

const actingNavLinks = [
	{ href: '/acting/', label: 'Home' },
	{ href: '/acting/about/', label: 'About' },
	{ href: '/acting/resume/', label: 'Resume' },
	{ href: '/acting/headshots/', label: 'Headshots' },
];

const navLinks = isActing ? actingNavLinks : danceNavLinks;
const brandHref = isActing ? '/acting/' : '/';
const titleSuffix = isActing ? 'Reischa Acting' : 'Reischa Dance';
const footerName = isActing ? 'Reischa Harrell' : 'Reischa Bellydance';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
		<link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
		<link rel="icon" href="/favicon.ico" sizes="any" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<title>{title} | {titleSuffix}</title>
	</head>
	<body>
		<header class="site-header">
			<div class="site-header__bar">
				<div class="site-header__brand">
					<a class="site-header__name" href={brandHref}>Reischa</a>
					<span class="site-header__tagline">
						<a href="/" aria-current={isActing ? undefined : 'true'}>Belly Dancer</a>
						<span aria-hidden="true">&middot;</span>
						<a href="/acting/" aria-current={isActing ? 'true' : undefined}>Actress</a>
					</span>
				</div>
				<button
					class="nav-toggle"
					id="nav-toggle"
					aria-expanded="false"
					aria-controls="primary-nav"
				>
					<span class="sr-only">Menu</span>
					<span class="nav-toggle__bars" aria-hidden="true"></span>
				</button>
				<nav class="primary-nav" id="primary-nav">
					<ul>
						{navLinks.map((link) => (
							<li><a href={link.href}>{link.label}</a></li>
						))}
					</ul>
				</nav>
			</div>
		</header>

		<main>
			<slot name="hero" />
			<div class="content-wrapper">
				<slot />
			</div>
		</main>

		<footer class="site-footer">
			<p>&copy; {new Date().getFullYear()} {footerName}.</p>
		</footer>

		<script>
			const toggle = document.getElementById('nav-toggle');
			const nav = document.getElementById('primary-nav');
			toggle?.addEventListener('click', () => {
				const isOpen = nav?.classList.toggle('is-open');
				toggle.setAttribute('aria-expanded', String(Boolean(isOpen)));
			});
		</script>
	</body>
</html>
