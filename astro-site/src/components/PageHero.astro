---
import { Image } from 'astro:assets';

export interface Props {
	image: ImageMetadata;
	title: string;
	imageAlt?: string;
	showTitle?: boolean;
}

const { image, title, imageAlt = '', showTitle = false } = Astro.props;
---

<div class="page-hero">
	<Image src={image} alt={imageAlt} width={1400} format="webp" />
	{showTitle ? (
		<h1 class="page-hero__title">{title}</h1>
	) : (
		<h1 class="sr-only">{title}</h1>
	)}
</div>

<style>
	.page-hero {
		position: relative;
		line-height: 0;
		max-height: 70vh;
		overflow: hidden;
	}

	.page-hero :global(img) {
		width: 100%;
		height: auto;
		display: block;
		margin: 0 auto;
	}

	.page-hero__title {
		position: absolute;
		inset: auto 0 0 0;
		margin: 0;
		padding: 3rem 1.5rem 1.25rem;
		background: linear-gradient(to top, rgb(20 8 24 / 75%), transparent);
		font-family: var(--font-script);
		font-size: clamp(2.25rem, 7vw, 3.75rem);
		line-height: 1;
		color: #fff;
		text-align: center;
	}
</style>
