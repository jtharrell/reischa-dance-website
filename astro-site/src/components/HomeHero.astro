---
import { Image } from 'astro:assets';

export interface Props {
	image: ImageMetadata;
	imageAlt?: string;
	imagePosition?: string;
	panelMaxWidth?: string;
	imageWidth?: string;
}

const {
	image,
	imageAlt = '',
	imagePosition = '22% center',
	panelMaxWidth = 'calc(34.5rem + 20%)',
	imageWidth,
} = Astro.props;

const capped = Boolean(imageWidth);
---

<div
	class:list={['home-hero', { 'home-hero--capped': capped }]}
	style={`--hero-image-position: ${imagePosition}; --hero-panel-max-width: ${panelMaxWidth}; ${imageWidth ? `--hero-image-width: ${imageWidth};` : ''}`}
>
	<Image class="home-hero__image" src={image} alt={imageAlt} width={2000} format="webp" />
	<div class="home-hero__scrim" aria-hidden="true"></div>
	<div class="home-hero__panel">
		<slot />
	</div>
</div>

<style>
	.home-hero {
		position: relative;
	}

	.home-hero__image {
		width: 100%;
		height: auto;
		display: block;
	}

	.home-hero__scrim {
		display: none;
	}

	.home-hero__panel {
		max-width: var(--content-max-width);
		margin: 0 auto;
		padding: 2rem 1.5rem 0.5rem;
	}

	.home-hero__panel :global(h1) {
		font-family: var(--font-script);
		font-size: clamp(2.5rem, 8vw, 3.5rem);
		line-height: 1;
		margin: 0 0 1rem;
	}

	@media (min-width: 56rem) {
		.home-hero {
			display: grid;
			min-height: min(72vh, 44rem);
		}

		.home-hero__image,
		.home-hero__scrim,
		.home-hero__panel {
			grid-area: 1 / 1;
		}

		.home-hero__image {
			width: 100%;
			height: 100%;
			object-fit: cover;
			object-position: var(--hero-image-position, 22% center);
		}

		.home-hero__scrim {
			display: block;
			background: linear-gradient(
				100deg,
				transparent 0%,
				transparent 28%,
				rgb(255 255 255 / 55%) 46%,
				rgb(255 255 255 / 85%) 60%
			);
		}

		.home-hero__panel {
			position: relative;
			z-index: 1;
			max-width: none;
			margin: 0;
			display: flex;
			flex-direction: column;
			justify-content: flex-start;
			align-items: flex-end;
			padding: 2rem clamp(1.5rem, 5vw, 4rem);
		}

		.home-hero__panel :global(> *) {
			width: 100%;
			max-width: var(--hero-panel-max-width, calc(34.5rem + 20%));
		}

		.home-hero__panel :global(h1),
		.home-hero__panel :global(p),
		.home-hero__panel :global(li) {
			color: var(--color-ink);
		}

		.home-hero__panel :global(h1) {
			color: var(--color-maroon);
		}

		.home-hero__panel :global(a) {
			color: var(--color-maroon);
		}

		.home-hero__panel :global(a:hover) {
			color: var(--color-mauve);
		}

		.home-hero__panel :global(.back-link) {
			text-align: center;
		}

		/* Capped variant: image sits in a fixed-width column at its natural
		   crop instead of being stretched full-bleed, for photos that don't
		   have blank space for the text panel to overlay on top of. */
		.home-hero--capped {
			display: flex;
			align-items: stretch;
			gap: clamp(1.5rem, 4vw, 3rem);
			min-height: 0;
			background: var(--color-surface);
		}

		.home-hero--capped .home-hero__image {
			flex: 0 0 auto;
			width: var(--hero-image-width, 22rem);
			height: 100%;
			min-height: min(72vh, 44rem);
			object-fit: cover;
			object-position: var(--hero-image-position, center);
		}

		.home-hero--capped .home-hero__scrim {
			display: none;
		}

		.home-hero--capped .home-hero__panel {
			position: static;
			flex: 1 1 auto;
			align-items: flex-start;
			justify-content: center;
			padding: 2rem clamp(1.5rem, 5vw, 4rem) 2rem 0;
		}
	}
</style>
