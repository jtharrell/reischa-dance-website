---
import { Image } from 'astro:assets';

export interface Props {
	image: ImageMetadata;
	imageAlt?: string;
	title: string;
	mediaFraction?: number;
	imageWidth?: number;
}

const { image, imageAlt = '', title, mediaFraction = 1 / 3, imageWidth = 800 } = Astro.props;
---

<div class="split-layout" style={`--media-fraction: ${mediaFraction}`}>
	<div class="split-layout__media">
		<Image src={image} alt={imageAlt} width={imageWidth} format="webp" />
	</div>
	<div class="split-layout__content">
		<h1>{title}</h1>
		<slot />
	</div>
</div>

<style>
	:global(main:has(.split-layout)) {
		background: var(--color-surface);
		color: var(--color-ink);
	}

	:global(main:has(.split-layout) h1),
	:global(main:has(.split-layout) h2),
	:global(main:has(.split-layout) h3),
	:global(main:has(.split-layout) h4) {
		color: var(--color-maroon);
	}

	:global(main:has(.split-layout) h1) {
		font-family: var(--font-script);
		font-size: clamp(2.5rem, 8vw, 3.5rem);
		line-height: 1;
		margin: 0 0 1rem;
	}

	:global(main:has(.split-layout) a) {
		color: var(--color-maroon);
	}

	:global(main:has(.split-layout) a:hover) {
		color: var(--color-mauve);
	}

	:global(main:has(.split-layout) .content-wrapper) {
		padding-top: 0;
	}

	:global(main:has(.split-layout) .section + .section) {
		border-top-color: rgb(58 36 48 / 15%);
	}

	.split-layout__content {
		padding-top: 2rem;
	}

	.split-layout {
		--content-fraction: calc(1 - var(--media-fraction, 0.3333));
		display: flex;
		flex-direction: column;
		gap: 2rem;
	}

	.split-layout__content :global(.lede) {
		color: var(--color-ink-soft);
	}

	.split-layout__media :global(img) {
		width: 100%;
		height: auto;
		display: block;
		border-radius: 0.5rem;
	}

	@media (min-width: 48rem) {
		.split-layout {
			flex-direction: row;
			align-items: stretch;
			gap: 2.5rem;
		}

		.split-layout__media {
			--gutter: max(0px, (100vw - var(--content-max-width)) / 2);
			--bleed: calc(var(--gutter) + 1.5rem);
			--media-base: calc((var(--media-fraction, 0.3333) * 100%) - (var(--media-fraction, 0.3333) * 2.5rem));
			flex: 0 0 auto;
			width: calc(var(--media-base) + var(--bleed));
			margin-left: calc(-1 * var(--bleed));
			display: flex;
		}

		.split-layout__media :global(img) {
			width: 100%;
			height: 100%;
			object-fit: cover;
			border-radius: 0;
		}

		.split-layout__content {
			flex: 1 1 calc((var(--content-fraction) * 100%) - (var(--content-fraction) * 2.5rem));
			min-width: 0;
		}
	}
</style>
